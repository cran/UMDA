\name{rhist}
\alias{rhist}

\title{
Data Simulation from a Histogram
}

\description{
Generates a set of simulated continuous data based on the information
from a histogram object. The function calculates the probability of each
interval based on its frequencies and generates uniformly distributed
values within the limits of the selected interval.
}

\usage{
rhist(histogram)
}

\arguments{
\item{histogram}{
An object of class "histogram", for example,
the result of running \code{hist(x)}, where \code{x}
follows any distribution with size \code{n}.
}
}

\value{
Returns a vector of size \code{n} that follows the
distribution of the histogram generated by \code{hist(x)},
which can be visualized by applying the \code{hist} function to
the generated vector.
}

\details{
The function performs a two-stage stochastic simulation process:
\enumerate{
\item \strong{Interval selection:} The empirical probability of each
bin is calculated by dividing its frequency by the total number of observations. Then,
\code{sample()} is used to assign each new observation to an interval proportionally
to its original weight.
\item \strong{Continuous generation:} Once the interval is assigned, a continuous
random value is generated using a uniform distribution (\code{runif}) bounded
by the limits of the corresponding bin (\code{min = intervals[i]}, \code{max = intervals[i+1]}).
}

This approach is useful when only the aggregated frequencies of a
histogram are available and an approximation of the original continuous data needs to be recreated.
}

\author{
Rogelio Salinas Gutiérrez, Juan Alberto Dávila del Alto, Jhon Daniel Aguilar Payares, Jonathan Michell Jauregui Carranza, Hiram Efraim Macias Ruelas, Byron Axel Morales Gutiérrez, María Fernanda Nieto Guerrero, Manuel Alonso Segoviano Baltazar, Pedro Abraham Montoya Calzada.
}

\examples{
% 1. Create an example dataset and its histogram
data <- rnorm(200, 5, 3)
x <- hist(data)

% 2. Simulate new data based on the histogram
new_data <- rhist(x)
hist(new_data) #image of the new data.
}

\keyword{datagen}
\keyword{distribution}
\keyword{nonparametric}
